        <mxCell id="c13" value="Private app subnets" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_private_subnet;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=0;" parent="1" vertex="1"><mxGeometry x="460" y="390" width="580" height="300" as="geometry"/></mxCell>
        <mxCell id="c14" value="Internal load balancer&lt;br&gt;&lt;font style='font-size:10px'&gt;staging header → :8081&lt;br&gt;otherwise → :80&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;" parent="1" vertex="1"><mxGeometry x="500" y="460" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c15" value="App server, EC2 t4g.small&lt;br&gt;&lt;font style='font-size:10px'&gt;Graviton, Compose, SSM only&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.instance2;" parent="1" vertex="1"><mxGeometry x="710" y="460" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;production :80&lt;/b&gt; (main)&lt;br&gt;nginx + PWA, API&lt;br&gt;&lt;b&gt;staging :8081&lt;/b&gt; (development)&lt;br&gt;nginx + PWA, API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="800" y="560" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="c17" value="S3 gateway endpoint&lt;br&gt;&lt;font style='font-size:10px'&gt;free&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;" parent="1" vertex="1"><mxGeometry x="950" y="440" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c18" value="Private database subnets (no internet route)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_private_subnet;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=0;" parent="1" vertex="1"><mxGeometry x="460" y="720" width="580" height="170" as="geometry"/></mxCell>
        <mxCell id="c19" value="RDS PostgreSQL 17, db.t4g.micro&lt;br&gt;&lt;font style='font-size:10px'&gt;healthconnect + healthconnect_staging&lt;br&gt;KMS-encrypted, TLS only, 7-day restore&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds_instance;" parent="1" vertex="1"><mxGeometry x="710" y="760" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c20" value="ECR&lt;br&gt;&lt;font style='font-size:10px'&gt;arm64 images, immutable,&lt;br&gt;scanned on push&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" parent="1" vertex="1"><mxGeometry x="1110" y="190" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c21" value="S3 media bucket&lt;br&gt;&lt;font style='font-size:10px'&gt;consent recordings, photos&lt;br&gt;SSE-KMS, versioned&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" parent="1" vertex="1"><mxGeometry x="1110" y="360" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c22" value="Secrets Manager&lt;br&gt;&lt;font style='font-size:10px'&gt;database password&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" parent="1" vertex="1"><mxGeometry x="1110" y="530" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c23" value="KMS key&lt;br&gt;&lt;font style='font-size:10px'&gt;alias/healthconnect-data&lt;br&gt;encrypts RDS, S3, secret, disk&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" parent="1" vertex="1"><mxGeometry x="1110" y="690" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c24" value="Systems Manager&lt;br&gt;&lt;font style='font-size:10px'&gt;Run Command deploys,&lt;br&gt;Session Manager&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" parent="1" vertex="1"><mxGeometry x="1330" y="190" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c25" value="CloudWatch&lt;br&gt;&lt;font style='font-size:10px'&gt;alarms, dashboard, logs&lt;br&gt;EC2 auto-recover, reboot&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" parent="1" vertex="1"><mxGeometry x="1330" y="360" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c26" value="SNS alerts&lt;br&gt;&lt;font style='font-size:10px'&gt;email the team&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" parent="1" vertex="1"><mxGeometry x="1330" y="530" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c27" value="EventBridge Scheduler&lt;br&gt;&lt;font style='font-size:10px'&gt;optional nightly stop&lt;br&gt;23:00-07:00 Ghana time&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge_scheduler;" parent="1" vertex="1"><mxGeometry x="1330" y="690" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c28" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ci.yml: lint, tests ≥70%, build,&lt;br&gt;Terraform, Trivy, gitleaks&lt;br&gt;deploy.yml: arm64 build → Trivy →&lt;br&gt;SSM release → health → rollback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292F;strokeColor=none;fontColor=#FFFFFF;fontSize=12;align=left;spacing=10;arcSize=8;" parent="1" vertex="1"><mxGeometry x="1600" y="130" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="c29" value="GitHub OIDC → IAM role&lt;br&gt;healthconnect-github-deploy&lt;br&gt;&lt;font style='font-size:10px'&gt;production needs approval; staging automatic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1600" y="300" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="c30" value="&lt;b&gt;Phones upload photos and recordings straight to S3&lt;/b&gt; with a 5-minute presigned link from the API." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="1600" y="420" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b&gt;Budget&lt;/b&gt;: $20/month on Project=healthconnect tags, alerts at 50 / 80 / 100%." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="1600" y="500" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;b&gt;us-east-1&lt;/b&gt;: CloudFront 5xx alarm + its SNS topic (CloudFront metrics live there)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="1600" y="570" width="240" height="60" as="geometry"/></mxCell>
