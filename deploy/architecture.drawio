        <mxCell id="c76" value="Doctor or nurse&lt;br&gt;&lt;font style='font-size:10px'&gt;same app, Referrals inbox&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.mobile_client;" parent="1" vertex="1"><mxGeometry x="60" y="760" width="41" height="66" as="geometry"/></mxCell>
        <mxCell id="c77" value="&lt;font color='#D6336C'&gt;&lt;b&gt;Video call (WebRTC)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Signalling over the API's WebSocket. Audio/video go phone to phone when they can; otherwise through our TURN relay in Cape Town (a login per call, expires in 4 h). 320×240, 15 fps, ≤250 kbps. Open from 15 min before to 2 h after the booking, once the GHS 20 fee is paid." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F5;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="20" y="870" width="360" height="110" as="geometry"/></mxCell>
        <mxCell id="c78" value="backups copied to Ireland" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6336C;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" parent="1" edge="1" source="c20" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c79" value="&lt;b&gt;Recovery (docs/runbooks/disaster-recovery.md)&lt;/b&gt;&lt;br&gt;Bad release: automatic rollback. Server lost: auto-recover / Terraform. Database: point-in-time restore (RPO ≈ 5 min, drill-tested). Region lost: restore from Ireland." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F5;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="20" y="1000" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="c80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6336C;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" parent="1" edge="1" source="c3" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c81" value="WebRTC media (direct)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6336C;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" parent="1" edge="1" source="c3" target="c76"><mxGeometry relative="1" as="geometry"/></mxCell>
