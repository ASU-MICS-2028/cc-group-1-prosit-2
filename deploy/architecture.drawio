<mxfile host="app.diagrams.net" agent="HealthConnect deploy docs" version="24.7.17">
  <diagram id="healthconnect-aws" name="HealthConnect on AWS">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="&lt;b&gt;HealthConnect Ghana: AWS architecture&lt;/b&gt;&lt;br&gt;Every request enters through CloudFront; nothing private faces the internet. Production and staging share one Graviton server.&lt;br&gt;&lt;font color='#D6336C'&gt;Pink: added since Lab 7 (events, texts, video calls with a TURN relay, payments, patient sign-in).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1500" height="66" as="geometry"/></mxCell>
        <mxCell id="c3" value="Health worker's or patient's phone&lt;br&gt;&lt;font style='font-size:10px'&gt;installed PWA, works offline&lt;br&gt;(IndexedDB + outbox)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.mobile_client;" parent="1" vertex="1"><mxGeometry x="60" y="380" width="41" height="66" as="geometry"/></mxCell>
        <mxCell id="c4" value="Edge (global)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=1;" parent="1" vertex="1"><mxGeometry x="170" y="250" width="200" height="420" as="geometry"/></mxCell>
        <mxCell id="c5" value="CloudFront: production&lt;br&gt;&lt;font style='font-size:10px'&gt;d2opah5iezm17k.cloudfront.net&lt;br&gt;HTTPS only, http → 301&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" parent="1" vertex="1"><mxGeometry x="242" y="300" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c6" value="CloudFront: staging&lt;br&gt;&lt;font style='font-size:10px'&gt;adds X-HC-Env: staging&lt;br&gt;noindex&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" parent="1" vertex="1"><mxGeometry x="242" y="500" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c7" value="AWS Cloud (account 659500703236)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" parent="1" vertex="1"><mxGeometry x="400" y="90" width="1160" height="1100" as="geometry"/></mxCell>
        <mxCell id="c8" value="Africa (Cape Town) af-south-1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=1;" parent="1" vertex="1"><mxGeometry x="420" y="130" width="1120" height="1040" as="geometry"/></mxCell>
        <mxCell id="c9" value="VPC healthconnect 10.30.0.0/16 (2 Availability Zones)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" parent="1" vertex="1"><mxGeometry x="440" y="170" width="620" height="740" as="geometry"/></mxCell>
        <mxCell id="c10" value="Public subnet" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_public_subnet;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#7AA116;dashed=0;" parent="1" vertex="1"><mxGeometry x="460" y="210" width="580" height="150" as="geometry"/></mxCell>
        <mxCell id="c11" value="fck-nat (t4g.nano)&lt;br&gt;&lt;font style='font-size:10px'&gt;self-healing, outbound only&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;" parent="1" vertex="1"><mxGeometry x="714" y="240" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c12" value="Internet gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.internet_gateway;" parent="1" vertex="1"><mxGeometry x="930" y="240" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;font color='#D6336C'&gt;&lt;b&gt;TURN relay (coturn)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;EC2 t4g.micro + Elastic IP; phones&lt;br&gt;relay calls through it when needed&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.instance2;" parent="1" vertex="1"><mxGeometry x="500" y="240" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c14" value="Private app subnets" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_private_subnet;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=0;" parent="1" vertex="1"><mxGeometry x="460" y="390" width="580" height="300" as="geometry"/></mxCell>
        <mxCell id="c15" value="Internal load balancer&lt;br&gt;&lt;font style='font-size:10px'&gt;staging header → :8081&lt;br&gt;otherwise → :80&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;" parent="1" vertex="1"><mxGeometry x="500" y="460" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c16" value="App server, EC2 t4g.small&lt;br&gt;&lt;font style='font-size:10px'&gt;Graviton, Compose, SSM only&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.instance2;" parent="1" vertex="1"><mxGeometry x="710" y="460" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;production :80&lt;/b&gt; (main)&lt;br&gt;nginx + PWA, API&lt;br&gt;&lt;b&gt;staging :8081&lt;/b&gt; (development)&lt;br&gt;nginx + PWA, API&lt;br&gt;&lt;font color='#D6336C'&gt;&lt;b&gt;+&lt;/b&gt; call signalling (WebSocket), Paystack fees, test results, prescriptions, patient sign-in, Health workers page&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="800" y="545" width="220" height="135" as="geometry"/></mxCell>
        <mxCell id="c18" value="S3 gateway endpoint&lt;br&gt;&lt;font style='font-size:10px'&gt;free&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;" parent="1" vertex="1"><mxGeometry x="950" y="440" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c19" value="Private database subnets (no internet route)" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_private_subnet;strokeColor=#00A4A6;fillColor=#E6F6F7;verticalAlign=top;align=left;spacingLeft=30;fontColor=#00A4A6;dashed=0;" parent="1" vertex="1"><mxGeometry x="460" y="720" width="580" height="170" as="geometry"/></mxCell>
        <mxCell id="c20" value="RDS PostgreSQL 17, db.t4g.micro&lt;br&gt;&lt;font style='font-size:10px'&gt;healthconnect + healthconnect_staging&lt;br&gt;KMS-encrypted, TLS only, 7-day restore&lt;br&gt;row-level security per district&lt;br&gt;+ results, prescriptions, payments, photos&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds_instance;" parent="1" vertex="1"><mxGeometry x="710" y="750" width="56" height="56" as="geometry"/></mxCell>
        <mxCell id="c21" value="ECR&lt;br&gt;&lt;font style='font-size:10px'&gt;arm64 images, immutable,&lt;br&gt;scanned on push&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" parent="1" vertex="1"><mxGeometry x="1110" y="190" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c22" value="S3 media bucket&lt;br&gt;&lt;font style='font-size:10px'&gt;consent recordings, photos&lt;br&gt;SSE-KMS, versioned&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" parent="1" vertex="1"><mxGeometry x="1110" y="360" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c23" value="Secrets Manager&lt;br&gt;&lt;font style='font-size:10px'&gt;database password&lt;br&gt;&lt;font color='#D6336C'&gt;+ SMS (httpSMS), Paystack,&lt;br&gt;TURN keys, per environment&lt;/font&gt;&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" parent="1" vertex="1"><mxGeometry x="1110" y="530" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c24" value="KMS key&lt;br&gt;&lt;font style='font-size:10px'&gt;alias/healthconnect-data&lt;br&gt;encrypts RDS, S3, secret, disk&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" parent="1" vertex="1"><mxGeometry x="1110" y="690" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c25" value="Systems Manager&lt;br&gt;&lt;font style='font-size:10px'&gt;Run Command deploys,&lt;br&gt;Session Manager&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;" parent="1" vertex="1"><mxGeometry x="1330" y="190" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c26" value="CloudWatch&lt;br&gt;&lt;font style='font-size:10px'&gt;alarms, dashboard, logs&lt;br&gt;EC2 auto-recover, reboot&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" parent="1" vertex="1"><mxGeometry x="1330" y="360" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c27" value="SNS alerts&lt;br&gt;&lt;font style='font-size:10px'&gt;email the team&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" parent="1" vertex="1"><mxGeometry x="1330" y="530" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c28" value="EventBridge Scheduler&lt;br&gt;&lt;font style='font-size:10px'&gt;optional nightly stop&lt;br&gt;23:00-07:00 Ghana time&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge_scheduler;" parent="1" vertex="1"><mxGeometry x="1330" y="690" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c29" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ci.yml: lint, tests ≥70%, build,&lt;br&gt;Terraform, Trivy, gitleaks, Lambda tests&lt;br&gt;deploy.yml: arm64 build → Trivy →&lt;br&gt;SSM release → health → rollback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292F;strokeColor=none;fontColor=#FFFFFF;fontSize=12;align=left;spacing=10;arcSize=8;" parent="1" vertex="1"><mxGeometry x="1600" y="130" width="240" height="120" as="geometry"/></mxCell>
        <mxCell id="c30" value="GitHub OIDC → IAM role&lt;br&gt;healthconnect-github-deploy&lt;br&gt;&lt;font style='font-size:10px'&gt;production needs approval; staging automatic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEE;strokeColor=#DD344C;fontSize=11;" parent="1" vertex="1"><mxGeometry x="1600" y="300" width="240" height="70" as="geometry"/></mxCell>
        <mxCell id="c31" value="&lt;b&gt;Phones upload photos and recordings straight to S3&lt;/b&gt; with a 5-minute presigned link from the API." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="1600" y="420" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c32" value="&lt;b&gt;Budget&lt;/b&gt;: $20/month on Project=healthconnect tags, alerts at 50 / 80 / 100%." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="1600" y="500" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="c33" value="&lt;b&gt;us-east-1&lt;/b&gt;: CloudFront 5xx alarm + its SNS topic (CloudFront metrics live there)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="1600" y="570" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="c34" value="Outside AWS" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#D6336C;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D6336C;dashed=1;" parent="1" vertex="1"><mxGeometry x="1590" y="660" width="260" height="320" as="geometry"/></mxCell>
        <mxCell id="c35" value="Disaster recovery: Europe (Ireland) eu-west-1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#D6336C;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D6336C;dashed=1;" parent="1" vertex="1"><mxGeometry x="1590" y="1000" width="260" height="170" as="geometry"/></mxCell>
        <mxCell id="c36" value="&lt;font color='#D6336C'&gt;&lt;b&gt;Database backups, replicated&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;every automated backup copied here,&lt;br&gt;re-encrypted with a KMS key in Ireland;&lt;br&gt;any second of the last 7 days restorable&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds_instance;" parent="1" vertex="1"><mxGeometry x="1695" y="1040" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c37" value="&lt;font style='font-size:10px'&gt;Reached over HTTPS: the API through fck-nat and the internet gateway; the Lambdas directly. Keys come from Secrets Manager.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#555555;" parent="1" vertex="1"><mxGeometry x="1605" y="920" width="235" height="50" as="geometry"/></mxCell>
        <mxCell id="c38" value="&lt;b&gt;httpSMS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Android phone, Telecel SIM&lt;br&gt;sign-in codes, reminders,&lt;br&gt;referral answers, prescriptions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F5;strokeColor=#D6336C;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1610" y="700" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="c39" value="&lt;b&gt;Paystack&lt;/b&gt; (test mode)&lt;br&gt;&lt;font style='font-size:10px'&gt;mobile money: MTN, Telecel, AirtelTigo&lt;br&gt;the phone pays on Paystack's page; the API&lt;br&gt;verifies it and takes a signed webhook&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F5;strokeColor=#D6336C;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1610" y="830" width="220" height="80" as="geometry"/></mxCell>
