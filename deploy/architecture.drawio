        <mxCell id="c56" value="Events (serverless): the API publishes visits booked / moved / cancelled, referral answers, prescriptions and abnormal results to two independent consumers" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=#D6336C;fillColor=#FFF0F5;verticalAlign=top;align=left;spacingLeft=30;fontColor=#D6336C;dashed=0;" parent="1" vertex="1"><mxGeometry x="440" y="940" width="1080" height="210" as="geometry"/></mxCell>
        <mxCell id="c57" value="SNS topic&lt;br&gt;&lt;font style='font-size:10px'&gt;appointment-events&lt;br&gt;KMS-encrypted&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" parent="1" vertex="1"><mxGeometry x="480" y="1010" width="48" height="48" as="geometry"/></mxCell>
        <mxCell id="c58" value="SQS reminders&lt;br&gt;&lt;font style='font-size:10px'&gt;+ DLQ after 3 tries&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" parent="1" vertex="1"><mxGeometry x="640" y="980" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="c59" value="SQS specialist-notify&lt;br&gt;&lt;font style='font-size:10px'&gt;referrals, teleconsults,&lt;br&gt;abnormal results only&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;" parent="1" vertex="1"><mxGeometry x="640" y="1065" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="c60" value="Lambda appointment-reminder&lt;br&gt;&lt;font style='font-size:10px'&gt;texts the patient, in their language&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" parent="1" vertex="1"><mxGeometry x="820" y="980" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="c61" value="Lambda specialist-notify&lt;br&gt;&lt;font style='font-size:10px'&gt;escalates an unanswered&lt;br&gt;emergency after 30 min&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" parent="1" vertex="1"><mxGeometry x="820" y="1065" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="c62" value="Scheduler&lt;br&gt;&lt;font style='font-size:10px'&gt;one per visit, 24 h before&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge_scheduler;" parent="1" vertex="1"><mxGeometry x="1000" y="980" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="c63" value="SNS clinician alerts&lt;br&gt;&lt;font style='font-size:10px'&gt;email; URGENT if emergency&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sns;" parent="1" vertex="1"><mxGeometry x="1000" y="1065" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="c64" value="DynamoDB&lt;br&gt;&lt;font style='font-size:10px'&gt;events each function handled&lt;br&gt;(no duplicate texts)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" parent="1" vertex="1"><mxGeometry x="1200" y="1065" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="c65" value="&lt;b&gt;SMS to the patient&lt;/b&gt;&lt;br&gt;via httpSMS (Arkesel also supported); sent at once, or by Scheduler when due" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="1170" y="970" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="c66" value="&lt;b&gt;Alarms&lt;/b&gt; on dead letters and function errors → SNS alerts. A failed publish never fails the save." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B3B3B3;fontSize=11;align=left;verticalAlign=top;spacing=8;arcSize=6;" parent="1" vertex="1"><mxGeometry x="1360" y="970" width="150" height="110" as="geometry"/></mxCell>
