        <mxCell id="c11" value="fck-nat (t4g.nano)&lt;br&gt;&lt;font style='font-size:10px'&gt;self-healing, outbound only&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.nat_gateway;" parent="1" vertex="1"><mxGeometry x="714" y="240" width="48" height="48" as="geometry"/></mxCell>
