        <mxCell id="c73" value="when due" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6336C;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" parent="1" edge="1" source="c62" target="c65"><mxGeometry relative="1" as="geometry"/></mxCell>
