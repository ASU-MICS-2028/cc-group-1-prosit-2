        <mxCell id="c2" value="&lt;b&gt;HealthConnect Ghana: AWS architecture&lt;/b&gt;&lt;br&gt;Every request enters through CloudFront; nothing private faces the internet. Production and staging share one Graviton server." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1100" height="50" as="geometry"/></mxCell>
        <mxCell id="c3" value="Health worker's phone&lt;br&gt;&lt;font style='font-size:10px'&gt;installed PWA, works offline&lt;br&gt;(IndexedDB + outbox)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.mobile_client;" parent="1" vertex="1"><mxGeometry x="60" y="380" width="41" height="66" as="geometry"/></mxCell>
