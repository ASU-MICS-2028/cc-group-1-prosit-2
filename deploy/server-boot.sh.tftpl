#!/bin/bash
# First boot of the HealthConnect app server (Amazon Linux 2023, arm64 or x86). Installs
# Docker, the PostgreSQL client (for the Lab 6 checks and the staging database) and writes the
# non-secret settings for both environments. Until the first deploy, a placeholder answers
# /health on both ports so the load balancer and HTTPS can be tested.
set -euo pipefail

dnf install -y docker postgresql16 jq
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m)" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# Container logs go to CloudWatch by default (the server's role may write to this group only),
# and stay small on the disk.
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<EOF
{
  "log-driver": "awslogs",
  "log-opts": { "awslogs-region": "${region}", "awslogs-group": "${log_group}", "tag": "{{.Name}}", "mode": "non-blocking" }
}
EOF
systemctl enable --now docker

mkdir -p /opt/healthconnect
# Amazon's CA bundle, so clients can check the database's certificate (sslmode=verify-full).
curl -fsSL https://truststore.pki.rds.amazonaws.com/${region}/${region}-bundle.pem \
  -o /opt/healthconnect/rds-ca.pem

# Settings, not secrets: the password is read from Secrets Manager at start-up with the
# server's own role, never written to disk. One file per environment; they differ only in
# the port and the database name (staging has its own database on the same RDS instance).
for env in production staging; do
  mkdir -p /opt/healthconnect/$env
  if [ "$env" = production ]; then port=80; db=healthconnect; else port=8081; db=healthconnect_staging; fi
  cat > /opt/healthconnect/$env/settings.env <<EOF
APP_ENV=$env
HOST_PORT=$port
AWS_REGION=${region}
DB_HOST=${db_host}
DB_NAME=$db
DB_SECRET_ARN=${db_secret}
DB_SSL_CA=/opt/healthconnect/rds-ca.pem
MEDIA_BUCKET=${media_bucket}
REGISTRY=${registry}
EOF
done

# Placeholder until the first deploy replaces it.
mkdir -p /opt/healthconnect/placeholder
cat > /opt/healthconnect/placeholder/default.conf <<'EOF'
server {
  listen 8080;
  location = /health { return 200 "ok\n"; }
  location / { return 200 "HealthConnect: first deploy pending\n"; }
}
EOF
for port in 80 8081; do
  docker run -d --name placeholder-$port --restart unless-stopped -p $port:8080 \
    -v /opt/healthconnect/placeholder/default.conf:/etc/nginx/conf.d/default.conf:ro \
    nginxinc/nginx-unprivileged:stable-alpine
done
