<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Folders keep short names (PlatformService); assemblies and namespaces are HealthConnect.PlatformService. -->
    <AssemblyName>HealthConnect.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>HealthConnect.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>
</Project>
