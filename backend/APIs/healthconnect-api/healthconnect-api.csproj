<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The API host: a thin composition root. It adds each service, sets up logging/errors/OpenAPI, and maps the features. No business logic here. -->
  <PropertyGroup>
    <AssemblyName>HealthConnect.Api</AssemblyName>
    <RootNamespace>HealthConnect.Api</RootNamespace>
    <!-- Write the OpenAPI document on every build; it is committed in docs/openapi as the contract the frontend reads. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\..\..\..\docs\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name healthconnect</OpenApiGenerateDocumentsOptions>
    <UserSecretsId>025f8055-78a5-4139-84b5-6bf468b560c7</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Services\Libs\SharedLibrary\SharedLibrary.csproj" />
    <ProjectReference Include="..\..\Services\Libs\Data\Data.csproj" />
    <ProjectReference Include="..\..\Services\PlatformService\PlatformService.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>
</Project>
