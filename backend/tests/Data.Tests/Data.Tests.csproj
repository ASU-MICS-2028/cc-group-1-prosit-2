<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Coverage is measured on the code these tests are about; CI enforces the threshold. -->
    <Include>[HealthConnect.Data]*</Include>
    <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
    <ExcludeByFile>**/*.g.cs,**/*.generated.cs,**/Migrations/**</ExcludeByFile>
    <SkipAutoProps>true</SkipAutoProps>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Services\Libs\Data\Data.csproj" />
    <ProjectReference Include="..\Shared\Tests.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="coverlet.msbuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Liza's first draft of the schema and its sample data: the starting point for the upgrade test. -->
    <EmbeddedResource Include="Fixtures\*.sql" LogicalName="HealthConnect.Data.Tests.Fixtures.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="HealthConnect.Tests.Shared" />
  </ItemGroup>
</Project>
